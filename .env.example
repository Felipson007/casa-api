# Copy to .env next to docker-compose.homelab.yml on the homelab host. Never commit the real file.

# Generate a fresh, strong password — never reuse the Java app's Postgres credentials.
# MUST be URL-safe (hex, not base64): it's interpolated unescaped into DATABASE_URL in
# docker-compose.homelab.yml, and base64's `/`/`+` break URL host:port parsing (learned the hard
# way — the first deploy attempt crash-looped on exactly this). Use `openssl rand -hex 24`.
DB_PASSWORD=change-me

# Must match the OAuth redirect URI already authorized in Google Cloud Console for this client.
APP_FRONTEND_ORIGIN=https://atlas-server.taile22ede.ts.net

# Optional private Go pprof listener. Keep empty in normal deployments; use 127.0.0.1:6060
# or a diagnostics-only network during a controlled profiling session.
PPROF_ADDR=
# Maximum execution time for an individual PostgreSQL statement.
DB_STATEMENT_TIMEOUT=5s

# 16/24/32-byte key, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts every stored
# external-integration refresh token AND each user's TOTP MFA secret — rotating it invalidates
# already-connected integrations and makes existing MFA secrets unreadable (users must re-enroll).
APP_ENCRYPTION_KEY=change-me

# --- Account security --------------------------------------------------------------------------
# Cloudflare Turnstile secret key (https://dash.cloudflare.com → Turnstile). When set, the
# change-password endpoint requires a valid captcha token; when empty, the check is skipped. The
# frontend pairs this with NEXT_PUBLIC_TURNSTILE_SITE_KEY. Never commit the real secret.
TURNSTILE_SECRET_KEY=
# Label authenticator apps show next to the Atlas account. Defaults to "Atlas".
MFA_TOTP_ISSUER=Atlas

# --- Auditoria (Configurações → Auditoria) ------------------------------------------------------
# Quantos dias os eventos de auditoria (logins, erros da aplicação, panics e exceções do frontend)
# ficam guardados antes de o recorder limpá-los automaticamente. Padrão: 3. Use 0 para desligar a
# limpeza (a tabela cresce sem limite — só faz sentido em testes).
AUDIT_RETENTION_DAYS=3

# Same Google OAuth client the Java app uses is fine to reuse (same redirect URI story) — or
# register a second OAuth client if you want the two backends fully independent.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# age (https://age-encryption.org) X25519 PUBLIC key — cmd/worker encrypts every pg_dump backup to
# it before writing to disk (see cmd/worker/main.go's runPgDump). Generate the keypair OFFLINE
# (`age-keygen`), on a machine that is NOT this server, and only ever put the public key
# ("age1...") here. The matching PRIVATE key must never touch this server — it's the only thing
# that can ever decrypt a backup, so it belongs in a password manager / offline drive instead.
# Leaving this unset degrades to plain, unencrypted backups (worker logs a warning) rather than
# refusing to start.
APP_BACKUP_AGE_RECIPIENT=change-me

# Segredo compartilhado que libera POST /api/public/dashboard-chat (a única rota fora do
# AuthMiddleware). Se ficar vazio, a rota NÃO é registrada — o widget de chat do dashboard externo
# para de funcionar até isto ser preenchido e o widget passar a enviar
# "Authorization: Bearer <token>" (ou o header "X-Dashboard-Token"). Gere com `openssl rand -hex 32`.
DASHBOARD_CHAT_TOKEN=
# Lista separada por vírgula de Origins de navegador para os quais a rota responde CORS. O widget
# do dashboard externo monta a URL a partir de window.location.hostname, então a mesma página chega
# (e manda Origin diferente) pelo IP da LAN, pelo nome Tailscale, etc. — liste todos.
# Ex.: http://192.168.0.200,https://atlas-server.taile22ede.ts.net
# Vazio = sem cabeçalhos CORS (apenas chamadas same-origin / server-to-server).
DASHBOARD_CHAT_ALLOWED_ORIGIN=

# --- Tenant self-service (docs/tenant-self-service.md) -----------------------------------------
# Liga POST /api/auth/signup, que provisiona um schema Postgres novo (tenant_<slug>) com as tabelas
# de domínio e o usuário OWNER daquele tenant. Desligado = a rota nem é registrada (404).
SIGNUP_ENABLED=false
# Opcional: se preenchido, o corpo do signup precisa repetir o valor em "inviteToken".
SIGNUP_INVITE_TOKEN=
# Tenant que representa os dados existentes em `public`. TENANT_DEFAULT_SCHEMA é "public" até o
# cutover mover as tabelas de domínio do dono para tenant_<slug> (ver runbook no doc).
TENANT_DEFAULT_SLUG=owner
TENANT_DEFAULT_SCHEMA=public
# KEK da envelope encryption (base64, 32 bytes — `openssl rand -base64 32`). Fica FORA do banco:
# ela embrulha a DEK de cada tenant. Sem ela, provisionar tenant falha (fail-closed). Perder essa
# chave torna os dados cifrados com as DEKs irrecuperáveis (crypto-shredding). Guarde-a com o mesmo
# cuidado da APP_ENCRYPTION_KEY — de preferência num gerenciador de segredos, não no git.
TENANT_MASTER_KEY=
